#!/usr/bin/env bash
# Blocks the push unless the commits being pushed pass the gates.
#
# 1) Secrets gate over all local refs PLUS every pushed ref tip and its history
#    (even a commit that no local ref points to). The scanner is never taken
#    from the working copy, the pushed commits or the push destination. It is
#    the committed scripts/check_secrets.sh (and .gitleaks.toml/.gitleaksignore)
#    of the revision you trust explicitly, once per clone:
#        git config forge.trustedRef refs/remotes/origin/main
#    That ref holds reviewed code you fetched yourself; keep it fetched.
#    Unset or unresolvable: the push is refused. If the trusted revision has no
#    scanner yet (the push that introduces the forge), the push is refused
#    unless run as FORGE_BOOTSTRAP=1 git push ..., which scans with each pushed
#    tip's own scanner.
# 2) Quality gate: each pushed ref tip is checked out in a clean temporary
#    worktree (no .env, no uncommitted changes) and runs its own scripts/check.sh,
#    so what is tested is what is published. Intermediate commits of a push
#    are not run individually; CI tests every pushed tip too.
#
# Trust boundary: this is a guard against mistakes by the person pushing, not
# against that person (git push --no-verify skips it). CI and branch protection
# are the controls that do not depend on the client.
#
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"

worktrees=()
cleanup() {
  local wt
  for wt in ${worktrees[@]+"${worktrees[@]}"}; do
    git -C "$repo_root" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
  done
}
trap cleanup EXIT

# checkout <commit>: clean detached worktree of <commit>; prints its path.
checkout() {
  local wt
  wt="$(mktemp -d "${TMPDIR:-/tmp}/prepush.XXXXXX")"
  git -C "$repo_root" worktree add --quiet --detach "$wt" "$1" >&2
  printf '%s\n' "$wt"
}

# Read what is being pushed before running any gate.
refs=()
shas=()
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue # branch deletion: nothing to test
  if ! git -C "$repo_root" cat-file -e "${local_sha}^{commit}" 2>/dev/null; then
    echo "pre-push: $local_ref @ $local_sha is not a commit; refusing to push it unchecked." >&2
    exit 1
  fi
  refs+=("$local_ref")
  shas+=("$local_sha")
done

[[ ${#shas[@]} -eq 0 ]] && exit 0

# Resolve the trusted scanner: only from an explicitly configured local ref.
bootstrap=0
trusted=""
trusted_ref="$(git -C "$repo_root" config --get forge.trustedRef || true)"
if [[ -z "$trusted_ref" ]]; then
  echo "pre-push: no trusted scanner configured; push aborted. Once per clone, run:" >&2
  echo "  git config forge.trustedRef refs/remotes/origin/main   # your reviewed default branch" >&2
  exit 1
fi
if trusted="$(git -C "$repo_root" rev-parse --verify --quiet "${trusted_ref}^{commit}")" \
  && git -C "$repo_root" cat-file -e "$trusted:scripts/check_secrets.sh" 2>/dev/null; then
  :
else
  trusted=""
  bootstrap=1 # the trusted ref does not exist yet, or predates the forge
fi

if [[ $bootstrap -eq 1 ]]; then
  if [[ "${FORGE_BOOTSTRAP:-}" != "1" ]]; then
    echo "pre-push: $trusted_ref has no reviewed scanner yet, so there is nothing trusted" >&2
    echo "  to scan with. If this is the push that introduces the forge, rerun with" >&2
    echo "  FORGE_BOOTSTRAP=1 git push ...   (each pushed tip is then scanned with its own scanner)." >&2
    exit 1
  fi
  echo "pre-push: FORGE_BOOTSTRAP=1: using each pushed tip's own scanner."
else
  echo "pre-push: secrets gate (scanner from $trusted_ref @ ${trusted:0:7}; all refs + pushed commits)..."
  wt="$(checkout "$trusted")"; worktrees+=("$wt")
  if ! (cd "$wt" && ./scripts/check_secrets.sh "${shas[@]}"); then
    echo "pre-push: secrets gate failed, push aborted." >&2
    exit 1
  fi
fi

for i in "${!shas[@]}"; do
  sha="${shas[$i]}"
  wt="$(checkout "$sha")"; worktrees+=("$wt")
  if [[ $bootstrap -eq 1 ]]; then
    echo "pre-push: secrets gate on ${refs[$i]} @ ${sha:0:7} (its committed scanner)..."
    if ! (cd "$wt" && ./scripts/check_secrets.sh "${shas[@]}"); then
      echo "pre-push: secrets gate failed, push aborted." >&2
      exit 1
    fi
  fi
  echo "pre-push: quality gate on ${refs[$i]} @ ${sha:0:7} (clean checkout)..."
  if ! (cd "$wt" && ./scripts/check.sh); then
    echo "pre-push: checks failed for ${refs[$i]} @ ${sha:0:7}, push aborted." >&2
    exit 1
  fi
done
