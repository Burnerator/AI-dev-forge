#!/usr/bin/env bash
# Blocks the push unless the commits being pushed pass the gates.
#
# 1) Secrets gate over all local refs PLUS every pushed ref tip and its history
#    (even a commit that no local ref points to). The scanner is never taken
#    from the working copy, the pushed commits or the push destination. It is
#    the committed scripts/check_secrets.sh (and .gitleaks.toml/.gitleaksignore)
#    of a commit you pinned after reviewing it, once per clone and again
#    whenever you accept a new scanner version:
#        scripts/trust-scanner.sh refs/remotes/origin/main
#    (it shows the scanner diff and stores the commit ID in forge.trustedCommit).
#    A pin does not move on fetch. Unset: the push is refused. If nothing is
#    pinned yet or the pinned commit has no scanner (the push that introduces
#    the forge), the push is refused unless run as FORGE_BOOTSTRAP=1 git push ...,
#    which scans with each pushed tip's own scanner.
# 2) Quality gate: each pushed ref tip is checked out in a clean temporary
#    worktree (no .env, no uncommitted changes) and runs its own scripts/check.sh,
#    so what is tested is what is published. Intermediate commits of a push
#    are not run individually; CI tests every pushed tip too.
#    That check.sh is code from the pushed commit, run with your privileges and
#    environment, exactly like running the project's tests yourself: only push
#    commits whose code you have read.
#
# Trust boundary: this is a guard against mistakes by the person pushing, not
# against that person (git push --no-verify skips it). CI and branch protection
# are the controls that do not depend on the client.
#
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
# Scan and check the objects git actually transfers, never replacement objects.
export GIT_NO_REPLACE_OBJECTS=1
repo_root="$(git rev-parse --show-toplevel)"

worktrees=()
cleanup() {
  local wt
  for wt in ${worktrees[@]+"${worktrees[@]}"}; do
    git -C "$repo_root" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
  done
}
trap cleanup EXIT

# checkout <commit>: clean detached worktree of <commit>; prints its path.
# Called in $(...), where errexit does not apply, so every step is checked.
checkout() {
  local wt
  wt="$(mktemp -d "${TMPDIR:-/tmp}/prepush.XXXXXX")" || return 1
  # Hooks off: a post-checkout hook from the project must not run pushed code
  # before the gates, or alter the checkout they test.
  if ! git -C "$repo_root" -c core.hooksPath=/dev/null worktree add --quiet --detach "$wt" "$1" >&2; then
    rm -rf "$wt"
    return 1
  fi
  printf '%s\n' "$wt"
}
checkout_failed() {
  echo "pre-push: cannot create a clean checkout of $1; no gate ran, push aborted." >&2
  exit 1
}

# Read what is being pushed before running any gate.
refs=()
shas=()
input_lines=() # kept verbatim, to hand to chained hooks
while IFS= read -r line; do
  input_lines+=("$line")
  read -r local_ref local_sha _remote_ref _remote_sha <<<"$line"
  [[ "$local_sha" =~ ^0+$ ]] && continue # deletion (all-zero ID, SHA-1 or SHA-256): nothing to test
  if ! git -C "$repo_root" cat-file -e "${local_sha}^{commit}" 2>/dev/null; then
    echo "pre-push: $local_ref @ $local_sha is not a commit; refusing to push it unchecked." >&2
    exit 1
  fi
  refs+=("$local_ref")
  shas+=("$local_sha")
done

# chain_existing_hooks: core.hooksPath replaces the hooks directory, so run what
# would otherwise have run: the project's previous pre-push hook in
# $GIT_COMMON_DIR/hooks (for example Git LFS or another tool's hook) or, if
# there is none and the repository uses Git LFS, `git lfs pre-push`. Without
# this, LFS objects would not be uploaded and clones would get bare pointers.
# If you already had a custom core.hooksPath (husky, lefthook, ...), record its
# pre-push hook before switching: git config forge.previousHook <path>.
chain_existing_hooks() {
  local legacy uses_lfs=0 tip
  legacy="$(git -C "$repo_root" config --get forge.previousHook || true)"
  if [[ -n "$legacy" ]]; then
    [[ "$legacy" != /* ]] && legacy="$repo_root/$legacy"
    if [[ ! -x "$legacy" ]]; then
      echo "pre-push: forge.previousHook '$legacy' is not an executable file; push aborted." >&2
      exit 1
    fi
  else
    legacy="$(git -C "$repo_root" rev-parse --git-common-dir)/hooks/pre-push"
    [[ "$legacy" != /* ]] && legacy="$repo_root/$legacy"
  fi
  if git -C "$repo_root" config --get-regexp '^filter\.lfs\.' >/dev/null 2>&1; then
    uses_lfs=1
  fi
  # LFS anywhere in the outgoing history (attributes or pointer files), not
  # just at the pushed tips or in the checked-out branch.
  if [[ $uses_lfs -eq 0 && ${#shas[@]} -gt 0 ]]; then
    if [[ -n "$(git -C "$repo_root" log --format=%H -1 -G 'filter=lfs' "${shas[@]}" --not --remotes -- .gitattributes '*/.gitattributes' 2>/dev/null)" ]] \
      || [[ -n "$(git -C "$repo_root" log --format=%H -1 -G '^version https://git-lfs.github.com/spec/v1' "${shas[@]}" --not --remotes 2>/dev/null)" ]]; then
      uses_lfs=1
    fi
    for tip in "${shas[@]}"; do # attributes present at a tip, even if already on a remote
      if git -C "$repo_root" grep -q 'filter=lfs' "$tip" -- .gitattributes '*/.gitattributes' 2>/dev/null; then
        uses_lfs=1
      fi
    done
  fi
  if [[ -x "$legacy" ]]; then
    echo "pre-push: running the previous pre-push hook ($legacy)..."
    printf '%s\n' ${input_lines[@]+"${input_lines[@]}"} | "$legacy" "$@" || {
      echo "pre-push: the previous pre-push hook failed, push aborted." >&2
      exit 1
    }
  fi
  # Always, when LFS is in use, even if a previous hook ran: that hook may not
  # be LFS's, and running git lfs pre-push twice is harmless.
  if [[ $uses_lfs -eq 1 ]]; then
    if ! command -v git-lfs >/dev/null 2>&1; then
      echo "pre-push: this push contains Git LFS content but git-lfs is not installed; push aborted." >&2
      exit 1
    fi
    echo "pre-push: running git lfs pre-push..."
    printf '%s\n' ${input_lines[@]+"${input_lines[@]}"} | git lfs pre-push "$@" || {
      echo "pre-push: git lfs pre-push failed, push aborted." >&2
      exit 1
    }
  fi
}

if [[ ${#shas[@]} -eq 0 ]]; then
  chain_existing_hooks "$@"
  exit 0
fi

# Resolve the trusted scanner: a pinned commit, never a ref that moves on fetch.
bootstrap=0
trusted="$(git -C "$repo_root" config --get forge.trustedCommit || true)"
if [[ -z "$trusted" ]]; then
  bootstrap=1 # nothing pinned yet
elif [[ ! "$trusted" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
  echo "pre-push: forge.trustedCommit must be a full commit ID, not '$trusted'; push aborted." >&2
  echo "  Pin a reviewed commit with: scripts/trust-scanner.sh <commit>" >&2
  exit 1
elif ! git -C "$repo_root" cat-file -e "${trusted}^{commit}" 2>/dev/null; then
  echo "pre-push: pinned scanner commit ${trusted:0:12} is not in this clone (fetch it); push aborted." >&2
  exit 1
elif ! git -C "$repo_root" cat-file -e "$trusted:scripts/check_secrets.sh" 2>/dev/null; then
  bootstrap=1 # the pinned commit predates the forge
fi

if [[ $bootstrap -eq 1 ]]; then
  if [[ "${FORGE_BOOTSTRAP:-}" != "1" ]]; then
    echo "pre-push: no trusted scanner pinned (or the pinned commit has none), so there is" >&2
    echo "  nothing reviewed to scan with. Pin one: scripts/trust-scanner.sh refs/remotes/origin/main" >&2
    echo "  Only for the push that introduces the forge: FORGE_BOOTSTRAP=1 git push ..." >&2
    echo "  (each pushed tip is then scanned with its own scanner)." >&2
    exit 1
  fi
  echo "pre-push: FORGE_BOOTSTRAP=1: using each pushed tip's own scanner."
else
  echo "pre-push: secrets gate (scanner from pinned commit ${trusted:0:12}; all refs + pushed commits)..."
  wt="$(checkout "$trusted")" || checkout_failed "pinned commit ${trusted:0:12}"
  worktrees+=("$wt")
  if ! (cd "$wt" && ./scripts/check_secrets.sh "${shas[@]}"); then
    echo "pre-push: secrets gate failed, push aborted." >&2
    exit 1
  fi
fi

for i in "${!shas[@]}"; do
  sha="${shas[$i]}"
  wt="$(checkout "$sha")" || checkout_failed "${refs[$i]} @ ${sha:0:7}"
  worktrees+=("$wt")
  if [[ $bootstrap -eq 1 ]]; then
    echo "pre-push: secrets gate on ${refs[$i]} @ ${sha:0:7} (its committed scanner)..."
    if ! (cd "$wt" && ./scripts/check_secrets.sh "${shas[@]}"); then
      echo "pre-push: secrets gate failed, push aborted." >&2
      exit 1
    fi
  fi
  echo "pre-push: quality gate on ${refs[$i]} @ ${sha:0:7} (clean checkout)..."
  if ! (cd "$wt" && ./scripts/check.sh); then
    echo "pre-push: checks failed for ${refs[$i]} @ ${sha:0:7}, push aborted." >&2
    exit 1
  fi
done

# All gates passed: run the hooks core.hooksPath would otherwise have bypassed.
chain_existing_hooks "$@"
